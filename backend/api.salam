package api

import crypto
import net.http
import encoding.json
import parse "parse.salam"
import clock "clock.salam"

mut _key := ""

pub struct Error:
    pub error: str = ""
end

pub func UseKey(key: str):
    _key = key
end

pub func Send<T>(ctx: i64, code: int, payload: T):
    http.Ctx_status(ctx, code)
    http.Ctx_set_header(ctx, "Access-Control-Allow-Origin", "*")
    http.Ctx_json(ctx, json.Marshal(payload))
end

pub func Fail(ctx: i64, code: int, message: str):
    Send(ctx, code, Error { error = message })
end

pub func Authorized(ctx: i64): bool:
    if crypto.SecretEquals(http.Ctx_header(ctx, "X-API-Key"), _key): ret true end
    Fail(ctx, 401, "unauthorized")
    ret false
end

pub func HeaderI64(ctx: i64, name: str): i64:
    raw := http.Ctx_header(ctx, name)
    if raw.len() == 0: ret 0 end
    ret parse.I64(raw)
end

pub func QueryI64(ctx: i64, name: str, fallback: i64): i64:
    raw := http.Ctx_query(ctx, name)
    if raw.len() == 0: ret fallback end
    ret parse.I64(raw)
end

pub func QueryLimit(ctx: i64, name: str, fallback: int, max: int): int:
    v := QueryI64(ctx, name, 0 as i64) as int
    if v <= 0: ret fallback end
    if v > max: ret max end
    ret v
end

pub func QueryCount(ctx: i64, name: str): int:
    v := QueryI64(ctx, name, 0 as i64) as int
    if v < 0: ret 0 end
    ret v
end

pub func QueryInstantMs(ctx: i64, name: str, fallback: i64): i64:
    ret clock.ParseInstantMs(http.Ctx_query(ctx, name), fallback)
end
