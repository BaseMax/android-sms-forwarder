package ingest

import encoding.json
import encoding.value
import encoding.encerr
import parse "parse.salam"
import clock "clock.salam"
import store "store.salam"
import notify "notify.salam"

pub struct Report:
    pub received: int = 0
    pub stored: int = 0
    pub duplicates: int = 0
    pub server_time_ms: i64 = 0
    pub server_time_utc: str = ""
end

pub struct Defaults:
    pub device: str = ""
    pub tz_offset_minutes: int = 0
    pub tz_name: str = ""
end

func _count(rep &: Report, created: bool):
    rep.received += 1
    if created:
        rep.stored += 1
    else:
        rep.duplicates += 1
    end
end

func _offset(item: value.Value, fallback: int): int:
    if value.ObjectHas(item, "tz_offset_minutes"):
        ret clock.NormalizeOffsetMinutes(parse.Number(item, "tz_offset_minutes"))
    end
    if value.ObjectHas(item, "tz_offset"):
        ret clock.NormalizeOffsetMinutes(parse.Number(item, "tz_offset"))
    end
    ret fallback
end

func _zone(item: value.Value, fallback: str): str:
    name := parse.TextOr(item, "tz_name", parse.TextOr(item, "timezone", fallback))
    ret clock.NormalizeZoneName(name)
end

func _one(item: value.Value, def: Defaults, now_ms: i64): bool:
    if !value.IsObject(item): ret false end
    address := parse.Text(item, "address")
    text := parse.Text(item, "body")
    if text.len() == 0 && address.len() == 0: ret false end
    mut kind := parse.Number(item, "type") as int
    if kind == 0: kind = 1 end
    date := clock.NormalizeMs(parse.Number(item, "date"), now_ms)
    offset := _offset(item, def.tz_offset_minutes)
    zone := _zone(item, def.tz_name)
    created := store.Save(store.Sms {
        device = parse.TextOr(item, "device", def.device),
        address = address,
        body = text,
        date = date,
        type = kind,
        tz_offset_minutes = offset,
        tz_name = zone
    })
    if created && kind == 1:
        notify.SmsAlert(address, text, date, offset, zone)
    end
    ret created
end

func _array(arr: value.Value, def: Defaults, now_ms: i64, rep &: Report):
    repeat value.ArrayLen(arr) with i:
        _count(rep, _one(value.ArrayGet(arr, i), def, now_ms))
    end
end

func _walk(v: value.Value, def: Defaults, now_ms: i64, rep &: Report):
    if value.IsArray(v):
        _array(v, def, now_ms, rep)
        ret
    end
    if value.IsObject(v) && value.ObjectHas(v, "messages"):
        _array(value.ObjectGet(v, "messages"), def, now_ms, rep)
        ret
    end
    _count(rep, _one(v, def, now_ms))
end

pub func Request(body: str, def: Defaults, rep &: Report): bool:
    now := clock.NowMs()
    rep.server_time_ms = now
    rep.server_time_utc = clock.UTC(now)
    mut e := encerr.NoError()
    mut v := json.Decode(body, e)
    mut ok := true
    if encerr.IsError(e):
        ok = false
    else:
        _walk(v, def, now, rep)
    end
    value.ValueFree(v)
    ret ok
end
