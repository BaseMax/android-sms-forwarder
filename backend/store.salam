package store

import db.sqlite
import sync
import clock "clock.salam"

const SCHEMA_VERSION := 1

const CREATE_MESSAGES := "CREATE TABLE IF NOT EXISTS messages (id INTEGER PRIMARY KEY AUTOINCREMENT, device TEXT NOT NULL DEFAULT '', address TEXT NOT NULL DEFAULT '', body TEXT NOT NULL DEFAULT '', date INTEGER NOT NULL DEFAULT 0, type INTEGER NOT NULL DEFAULT 1, received_at INTEGER NOT NULL DEFAULT 0, tz_offset INTEGER NOT NULL DEFAULT 0, tz_name TEXT NOT NULL DEFAULT '')"

const COLUMNS := "id, device, address, body, date, type, received_at, tz_offset, tz_name"

const MATCHING := " FROM messages WHERE date >= ?"

mut _db := sqlite.Database {}
mut _lock := sync.Mutex {}
mut _ready := false

pub struct Sms:
    pub id: i64 = 0
    pub device: str = ""
    pub address: str = ""
    pub body: str = ""
    pub date: i64 = 0
    pub date_utc: str = ""
    pub date_local: str = ""
    pub type: int = 1
    pub tz_offset_minutes: int = 0
    pub tz_name: str = ""
    pub received_at: i64 = 0
    pub received_at_utc: str = ""
end

func _row(rows: sqlite.Rows): Sms:
    date := sqlite.Int64(rows, 4)
    offset := sqlite.Int(rows, 7)
    received := sqlite.Int64(rows, 6)
    ret Sms {
        id = sqlite.Int64(rows, 0),
        device = sqlite.Text(rows, 1),
        address = sqlite.Text(rows, 2),
        body = sqlite.Text(rows, 3),
        date = date,
        date_utc = clock.UTC(date),
        date_local = clock.Local(date, offset),
        type = sqlite.Int(rows, 5),
        tz_offset_minutes = offset,
        tz_name = sqlite.Text(rows, 8),
        received_at = received,
        received_at_utc = clock.UTC(received)
    }
end

func _select(since: i64, limit: int, offset: int): Vector<Sms>:
    mut out := Vector {} as Vector<Sms>
    rows := sqlite.Prepare(_db, "SELECT " + COLUMNS + MATCHING + " ORDER BY date DESC, id DESC LIMIT ? OFFSET ?")
    sqlite.BindInt(rows, 1, since)
    sqlite.BindInt(rows, 2, limit as i64)
    sqlite.BindInt(rows, 3, offset as i64)
    until sqlite.Next(rows):
        out.push(_row(rows))
    end
    sqlite.Finish(rows)
    ret out
end

func _count(since: i64): i64:
    rows := sqlite.Prepare(_db, "SELECT COUNT(*)" + MATCHING)
    sqlite.BindInt(rows, 1, since)
    mut n := 0 as i64
    if sqlite.Next(rows): n = sqlite.Int64(rows, 0) end
    sqlite.Finish(rows)
    ret n
end

func _table_exists(): bool:
    ret sqlite.QueryInt(_db, "SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name='messages'") > 0
end

func _version(): int:
    ret sqlite.QueryInt(_db, "PRAGMA user_version")
end

func _upgrade_to_1():
    sqlite.Exec(_db, "ALTER TABLE messages ADD COLUMN tz_offset INTEGER NOT NULL DEFAULT 0")
    sqlite.Exec(_db, "ALTER TABLE messages ADD COLUMN tz_name TEXT NOT NULL DEFAULT ''")
    sqlite.Exec(_db, "UPDATE messages SET received_at = received_at * 1000 WHERE received_at > 0 AND received_at < 946684800000")
    sqlite.Exec(_db, "UPDATE OR IGNORE messages SET date = date * 1000 WHERE date > 0 AND date < 946684800000")
end

func _migrate():
    sqlite.Exec(_db, "PRAGMA journal_mode=WAL")
    sqlite.Exec(_db, "PRAGMA busy_timeout=5000")
    fresh := !_table_exists()
    sqlite.Exec(_db, CREATE_MESSAGES)
    if fresh:
        sqlite.Exec(_db, "PRAGMA user_version=1")
    end
    if _version() < SCHEMA_VERSION:
        _upgrade_to_1()
        sqlite.Exec(_db, "PRAGMA user_version=1")
    end
    sqlite.Exec(_db, "CREATE UNIQUE INDEX IF NOT EXISTS ux_messages_natural ON messages(address, body, date, type)")
    sqlite.Exec(_db, "CREATE INDEX IF NOT EXISTS ix_messages_date ON messages(date)")
end

pub func Init(path: str): bool:
    if !sqlite.Available(): ret false end
    _db = sqlite.Open(path)
    if !sqlite.Ok(_db): ret false end
    _lock = sync.NewMutex()
    _migrate()
    _ready = true
    ret true
end

pub func Close():
    if _ready: sqlite.Close(_db) end
end

pub func Save(m: Sms): bool:
    sync.Lock(_lock)
    defer sync.Unlock(_lock)
    ins := sqlite.Prepare(_db, "INSERT OR IGNORE INTO messages(device, address, body, date, type, received_at, tz_offset, tz_name) VALUES (?, ?, ?, ?, ?, ?, ?, ?)")
    sqlite.BindText(ins, 1, m.device)
    sqlite.BindText(ins, 2, m.address)
    sqlite.BindText(ins, 3, m.body)
    sqlite.BindInt(ins, 4, m.date)
    sqlite.BindInt(ins, 5, m.type as i64)
    sqlite.BindInt(ins, 6, clock.NowMs())
    sqlite.BindInt(ins, 7, m.tz_offset_minutes as i64)
    sqlite.BindText(ins, 8, m.tz_name)
    sqlite.Next(ins)
    sqlite.Finish(ins)
    ret sqlite.Changes(_db) > 0
end

pub func ListPage(since: i64, limit: int, offset: int, total &: i64): Vector<Sms>:
    sync.Lock(_lock)
    defer sync.Unlock(_lock)
    items := _select(since, limit, offset)
    total = _count(since)
    ret items
end

pub func Total(): i64:
    sync.Lock(_lock)
    defer sync.Unlock(_lock)
    ret _count(0 as i64)
end
