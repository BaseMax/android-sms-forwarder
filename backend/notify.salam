package notify

import telegram.bot
import clock "clock.salam"

mut client := bot.Bot {}
mut chatId := 0 as i64
mut active := false

func formatWhen(date_ms: i64, tz_offset_minutes: int, tz_name: str): str:
    mut s := "When: " + clock.UTC(date_ms) + " (UTC)"
    if tz_offset_minutes != 0 || tz_name.len() > 0:
        mut where := ""
        if tz_name.len() > 0: where = " " + tz_name end
        s = s + "\nPhone: " + clock.Local(date_ms, tz_offset_minutes) + where
    end
    ret s
end

pub func Init(token: str, chat_id: i64): bool:
    if token.len() == 0 || chat_id == 0 as i64:
        active = false
        ret false
    end
    client = bot.NewBot(token)
    chatId = chat_id
    active = true
    ret true
end

pub func Enabled(): bool:
    ret active
end

pub func SmsAlert(address: str, body: str, date_ms: i64, tz_offset_minutes: int, tz_name: str):
    if !active: ret end
    mut from := address
    if from.len() == 0: from = "(unknown)" end
    text := "New SMS received\n\nFrom: " + from + "\n" + formatWhen(date_ms, tz_offset_minutes, tz_name) + "\n\n" + body
    bot.SendMessage(client, chatId, text)
end
