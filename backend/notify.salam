package notify

import telegram.bot
import clock "clock.salam"
import store "store.salam"
import sync
import chan
import time

const QUEUE_CAPACITY := 65536 as i64
const THROTTLE_MS := 1100
const BACKOFF_MS := 5000

mut client := bot.Bot {}
mut chatId := 0 as i64
mut active := false
mut queue := chan.Chan {} as chan.Chan<str>

func typeLabel(kind: int): str:
    if kind == 2: ret "sent" end
    ret "received"
end

func format(m: store.Sms): str:
    mut from := m.address
    if from.len() == 0: from = "(unknown)" end
    mut text := "SMS " + typeLabel(m.type) + "\nNumber: " + from
    text = text + "\nWhen: " + clock.UTC(m.date) + " (UTC)"
    if m.tz_offset_minutes != 0 || m.tz_name.len() > 0:
        mut zone := ""
        if m.tz_name.len() > 0: zone = " " + m.tz_name end
        text = text + "\nLocal: " + clock.Local(m.date, m.tz_offset_minutes) + zone
    end
    ret text + "\n\n" + m.body
end

func drain():
    mut ok := true
    until true:
        text := queue.recv(ok)
        if !ok: break end
        resp := bot.SendMessage(client, chatId, text)
        if !bot.Ok(resp):
            time.Sleep(BACKOFF_MS)
        end
        time.Sleep(THROTTLE_MS)
    end
end

pub func Init(token: str, chat_id: i64): bool:
    if token.len() == 0 || chat_id == 0 as i64:
        active = false
        ret false
    end
    client = bot.NewBot(token)
    chatId = chat_id
    queue.init(QUEUE_CAPACITY)
    active = true
    spawn(drain)
    ret true
end

pub func Enabled(): bool:
    ret active
end

pub func Enqueue(m: store.Sms):
    if !active: ret end
    queue.send(format(m))
end
