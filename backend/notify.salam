package notify

import telegram.bot
import clock "clock.salam"
import store "store/store.salam"
import str
import time

const BATCH_LIMIT := 50
const THROTTLE_MS := 1100
const IDLE_POLL_MS := 1000
const RETRY_WAIT_MS := 5000
const MAX_BODY := 3500

const SENT := 0
const RETRY := 1
const DROP := 2

mut client := bot.Bot {}
mut chatIdText := ""
mut active := false

func headerLine(kind: int): str:
    if kind == 2: ret "📤 SMS sent" end
    ret "📩 New SMS received"
end

func partyLine(kind: int, who: str): str:
    mut name := who
    if name.len() == 0: name = "(unknown)" end
    if kind == 2: ret "👤 To: " + name end
    ret "👤 From: " + name
end

func prettyTime(iso: str): str:
    if iso.len() < 19: ret iso end
    ret iso.substr(0, 10) + " " + iso.substr(11, 8)
end

func clip(body: str): str:
    if body.len() > MAX_BODY: ret body.substr(0, MAX_BODY) + " ..." end
    ret body
end

func format(m: store.Sms): str:
    mut text := headerLine(m.type)
    text = text + "\n\n" + partyLine(m.type, m.address)
    text = text + "\n🕒 " + prettyTime(clock.UTC(m.date)) + " UTC"
    if m.tz_offset_minutes != 0 || m.tz_name.len() > 0:
        mut zone := ""
        if m.tz_name.len() > 0: zone = " (" + m.tz_name + ")" end
        text = text + "\n🌍 " + prettyTime(clock.Local(m.date, m.tz_offset_minutes)) + zone
    end
    ret text + "\n\n💬 " + clip(m.body)
end

func send(text: str): bot.ApiResponse:
    mut params := HashMap {} as HashMap<str, str>
    params.put("chat_id", chatIdText)
    params.put("text", text)
    ret bot.Call(client, "sendMessage", params)
end

func classify(resp: bot.ApiResponse): int:
    if bot.Ok(resp): ret SENT end
    code := resp.error_code
    if code == 0 as i64 || code == 429 as i64 || code >= 500 as i64: ret RETRY end
    ret DROP
end

func worker():
    until true:
        batch := store.Pending(BATCH_LIMIT)
        if batch.len() == 0:
            batch.free()
            time.Sleep(IDLE_POLL_MS)
        else:
            mut paused := false
            each m in batch:
                if !paused:
                    outcome := classify(send(format(m)))
                    if outcome == SENT:
                        store.MarkNotified(m.id)
                        time.Sleep(THROTTLE_MS)
                    else:
                        if outcome == DROP:
                            println "[notify] giving up on message ", m.id
                            store.MarkFailed(m.id)
                            time.Sleep(THROTTLE_MS)
                        else:
                            paused = true
                        end
                    end
                end
            end
            batch.free()
            if paused: time.Sleep(RETRY_WAIT_MS) end
        end
    end
end

pub func Init(token: str, chat_id: i64): bool:
    if token.len() == 0 || chat_id == 0 as i64:
        active = false
        ret false
    end
    client = bot.NewBot(token)
    chatIdText = str.FromInt(chat_id)
    active = true
    spawn(worker)
    ret true
end

pub func Enabled(): bool:
    ret active
end
