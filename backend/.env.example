# Copy to .env and fill in. The service reads these from the environment.

# Required. The shared secret the phone sends in the X-API-Key header.
# Generate one, e.g.:  openssl rand -hex 32
API_KEY=change-me-to-a-long-random-secret

# Where the SQLite file lives. Created on first run.
DB_PATH=sms.db

# Port to listen on.
PORT=8080

# Optional Telegram alerting. Leave blank to disable (SMS are still stored).
# BOT_TOKEN from @BotFather; TELEGRAM_CHAT_ID is your own numeric id
# (message @userinfobot to find it).
BOT_TOKEN=
TELEGRAM_CHAT_ID=
