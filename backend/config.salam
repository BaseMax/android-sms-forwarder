package config

import os
import env

const DEFAULT_DB := "sms.db"
const DEFAULT_PORT := 8080

pub struct Config:
    pub api_key: str = ""
    pub db_path: str = DEFAULT_DB
    pub port: int = DEFAULT_PORT
    pub bot_token: str = ""
    pub chat_id: i64 = 0
end

func loadDotEnv():
    if os.Exists(".env"):
        env.Load(".env")
    else:
        env.Load("../.env")
    end
end

pub func FromEnv(): Config:
    loadDotEnv()
    ret Config {
        api_key = env.Get("API_KEY"),
        db_path = env.GetOr("DB_PATH", DEFAULT_DB),
        port = env.GetInt("PORT", DEFAULT_PORT as i64) as int,
        bot_token = env.Get("BOT_TOKEN"),
        chat_id = env.GetInt("TELEGRAM_CHAT_ID", 0 as i64)
    }
end
