package config

import os
import parse "parse.salam"

const DEFAULT_DB := "sms.db"
const DEFAULT_PORT := 8080

pub struct Config:
    pub api_key: str = ""
    pub db_path: str = DEFAULT_DB
    pub port: int = DEFAULT_PORT
    pub bot_token: str = ""
    pub chat_id: i64 = 0
end

func _text(name: str, fallback: str): str:
    v := os.Env(name)
    if v.len() == 0: ret fallback end
    ret v
end

func _num(name: str, fallback: i64): i64:
    v := os.Env(name)
    if v.len() == 0: ret fallback end
    ret parse.I64(v)
end

pub func FromEnv(): Config:
    ret Config {
        api_key = os.Env("API_KEY"),
        db_path = _text("DB_PATH", DEFAULT_DB),
        port = _num("PORT", DEFAULT_PORT as i64) as int,
        bot_token = os.Env("BOT_TOKEN"),
        chat_id = _num("TELEGRAM_CHAT_ID", 0 as i64)
    }
end
