package routes

import net.http
import net.router
import api "api.salam"
import clock "clock.salam"
import ingest "ingest.salam"
import store "store.salam"
import notify "notify.salam"

const PAGE_DEFAULT := 100
const PAGE_MAX := 1000

pub struct Page:
    pub items: Vector<store.Sms> = Vector {} as Vector<store.Sms>
    pub count: i64 = 0
    pub since: i64 = 0
    pub since_utc: str = ""
    pub server_time_ms: i64 = 0
    pub server_time_utc: str = ""
end

pub struct Stats:
    pub total: i64 = 0
    pub server_time_ms: i64 = 0
    pub server_time_utc: str = ""
end

pub struct Health:
    pub status: str = "ok"
    pub service: str = "sms-forwarder"
    pub notifications: bool = false
    pub timezone: str = "UTC"
    pub server_time_ms: i64 = 0
    pub server_time_utc: str = ""
end

func _defaults(ctx: i64): ingest.Defaults:
    ret ingest.Defaults {
        device = http.Ctx_header(ctx, "X-Device-Id"),
        tz_offset_minutes = clock.NormalizeOffsetMinutes(api.HeaderI64(ctx, "X-Tz-Offset")),
        tz_name = clock.NormalizeZoneName(http.Ctx_header(ctx, "X-Tz-Name"))
    }
end

func _create_sms(ctx: i64):
    if !api.Authorized(ctx): ret end
    body := http.Ctx_body(ctx)
    if body.len() == 0:
        api.Fail(ctx, 400, "empty request body")
        ret
    end
    mut rep := ingest.Report {}
    if !ingest.Request(body, _defaults(ctx), rep):
        api.Fail(ctx, 400, "invalid JSON")
        ret
    end
    api.Send(ctx, 200, rep)
end

func _list_sms(ctx: i64):
    if !api.Authorized(ctx): ret end
    since := api.QueryInstantMs(ctx, "since", 0 as i64)
    limit := api.QueryLimit(ctx, "limit", PAGE_DEFAULT, PAGE_MAX)
    offset := api.QueryCount(ctx, "offset")
    now := clock.NowMs()
    mut total := 0 as i64
    items := store.ListPage(since, limit, offset, total)
    api.Send(ctx, 200, Page {
        items = items,
        count = total,
        since = since,
        since_utc = clock.UTC(since),
        server_time_ms = now,
        server_time_utc = clock.UTC(now)
    })
end

func _stats(ctx: i64):
    if !api.Authorized(ctx): ret end
    now := clock.NowMs()
    api.Send(ctx, 200, Stats {
        total = store.Total(),
        server_time_ms = now,
        server_time_utc = clock.UTC(now)
    })
end

func _health(ctx: i64):
    now := clock.NowMs()
    api.Send(ctx, 200, Health {
        notifications = notify.Enabled(),
        server_time_ms = now,
        server_time_utc = clock.UTC(now)
    })
end

pub func Register(r &: router.Router):
    router.Post(r, "/api/sms", _create_sms)
    router.Get(r, "/api/sms", _list_sms)
    router.Get(r, "/api/stats", _stats)
    router.Get(r, "/health", _health)
end
