package routes

import net.http
import net.router
import api "api.salam"
import clock "clock.salam"
import ingest "ingest.salam"
import store "store.salam"
import notify "notify.salam"
import responses "responses.salam"

const PAGE_DEFAULT := 100
const PAGE_MAX := 1000

func defaultsFrom(ctx: i64): ingest.Defaults:
    ret ingest.Defaults {
        device = http.Ctx_header(ctx, "X-Device-Id"),
        tz_offset_minutes = clock.NormalizeOffsetMinutes(api.HeaderI64(ctx, "X-Tz-Offset")),
        tz_name = clock.NormalizeZoneName(http.Ctx_header(ctx, "X-Tz-Name"))
    }
end

func postSms(ctx: i64):
    if !api.Authorized(ctx): ret end
    body := http.Ctx_body(ctx)
    if body.len() == 0:
        api.Fail(ctx, 400, "empty request body")
        ret
    end
    mut rep := ingest.Report {}
    if !ingest.Request(body, defaultsFrom(ctx), rep):
        api.Fail(ctx, 400, "invalid JSON")
        ret
    end
    api.Send(ctx, 200, rep)
end

func getSms(ctx: i64):
    if !api.Authorized(ctx): ret end
    since := api.QueryInstantMs(ctx, "since", 0 as i64)
    limit := api.QueryLimit(ctx, "limit", PAGE_DEFAULT, PAGE_MAX)
    offset := api.QueryCount(ctx, "offset")
    now := clock.NowMs()
    mut total := 0 as i64
    items := store.ListPage(since, limit, offset, total)
    api.Send(ctx, 200, responses.Page {
        items = items,
        count = total,
        since = since,
        since_utc = clock.UTC(since),
        server_time_ms = now,
        server_time_utc = clock.UTC(now)
    })
end

func getStats(ctx: i64):
    if !api.Authorized(ctx): ret end
    now := clock.NowMs()
    api.Send(ctx, 200, responses.Stats {
        total = store.Total(),
        server_time_ms = now,
        server_time_utc = clock.UTC(now)
    })
end

func getHealth(ctx: i64):
    now := clock.NowMs()
    api.Send(ctx, 200, responses.Health {
        notifications = notify.Enabled(),
        server_time_ms = now,
        server_time_utc = clock.UTC(now)
    })
end

func notFound(ctx: i64):
    api.Fail(ctx, 404, "not found")
end

pub func Register(r &: router.Router):
    router.Post(r, "/api/sms", postSms)
    router.Get(r, "/api/sms", getSms)
    router.Get(r, "/api/stats", getStats)
    router.Get(r, "/health", getHealth)
    router.Get(r, "*", notFound)
    router.Post(r, "*", notFound)
    router.Put(r, "*", notFound)
    router.Delete(r, "*", notFound)
    router.Patch(r, "*", notFound)
    router.Head(r, "*", notFound)
    router.Options(r, "*", notFound)
end
