package parse

import conv
import encoding.value

pub func I64(s: str): i64:
    n := s.len()
    if n == 0: ret 0 end
    mut i := 0
    mut neg := false
    if s.substr(0, 1) == "-":
        neg = true
        i = 1
    end
    mut r := 0 as i64
    until i < n:
        ch := s.substr(i, 1)
        if ch < "0" || ch > "9": break end
        r = r * (10 as i64) + (ch.to_int() as i64)
        i += 1
    end
    if neg: ret 0 as i64 - r end
    ret r
end

pub func Text(item: value.Value, key: str): str:
    if !value.ObjectHas(item, key): ret "" end
    f := value.ObjectGet(item, key)
    if value.IsString(f): ret value.AsString(f) end
    if value.IsInt(f): ret conv.FormatInt(value.AsInt(f)) end
    ret ""
end

pub func TextOr(item: value.Value, key: str, fallback: str): str:
    s := Text(item, key)
    if s.len() == 0: ret fallback end
    ret s
end

pub func Number(item: value.Value, key: str): i64:
    if !value.ObjectHas(item, key): ret 0 end
    f := value.ObjectGet(item, key)
    if value.IsString(f): ret I64(value.AsString(f)) end
    if value.IsInt(f): ret value.AsInt(f) end
    if value.IsFloat(f): ret value.AsFloat(f) as i64 end
    ret 0
end
